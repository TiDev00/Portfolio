root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown
[*.{md,mdx}]
trim_trailing_whitespace = false

# Lockfiles
[{pnpm-lock.yaml,package-lock.json,yarn.lock}]
insert_final_newline = unset
trim_trailing_whitespace = unset